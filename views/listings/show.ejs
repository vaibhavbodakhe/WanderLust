<% layout("/layouts/boilerplate.ejs") %>

<div class="row justify-content-center mt-4 show-page">
    <div class="col-md-8 col-lg-7">
        <h3 class="mb-2">Listing Details</h3>

        <div class="show-listing">
            <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=80' %>" class="show-listing-image" alt="<%= listing.title %>">
            <div class="show-listing-details">
                <h5><%= listing.title %></h5>
                <p><%= listing.description %></p>
                <p>
                    &#8377; <%= listing.price.toLocaleString("en-IN") %><br>
                    <%= listing.location %><br>
                    <%= listing.country %>
                </p>
            </div>
        </div>

        <div class="show-listing-actions">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger edit-btn">Edit</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-dark">Delete</button>
            </form>
        </div>
    </div>
</div>
